  <joint name="camera_fixed_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_link"/>
    <origin rpy="0.163640 -1.535191 1.364251" xyz="0.001623 -0.106306 0.013148"/>
  </joint>
  <!-- 2. Spacer Cylinder between tool0 and Gripper -->
  <!-- Bán kính 5cm (0.05m), Độ dày 1.5cm (0.015m) -->
  <link name="spacer_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.015" radius="0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.015" radius="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="spacer_joint" type="fixed">
    <parent link="tool0"/>
    <child link="spacer_cylinder"/>
    <!-- Đặt tâm của hình trụ vào giữa khoảng trống (0.015 / 2 = 0.0075) -->
    <origin rpy="0 0 0" xyz="0 0 0.0075"/>
  </joint>
  <ros2_control name="SusGripGazeboSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="gripper_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.065</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>

